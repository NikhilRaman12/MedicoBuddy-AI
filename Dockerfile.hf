# ──────────────────────────────────────────────────────────────
# MedicoBuddy AI — Hugging Face Spaces Single-Container Runtime
#
# Runs all 5 services in one container:
#   PostgreSQL 16 + pgvector  (localhost:5432)
#   Neo4j Community Edition   (localhost:7687)
#   Qwen3-Embedding-0.6B      (in-process)
#   FastAPI backend            (127.0.0.1:8000)
#   Streamlit frontend         (0.0.0.0:7860)
#
# Port 7860 is the only public port (Hugging Face requirement).
# ──────────────────────────────────────────────────────────────

FROM python:3.12-slim

WORKDIR /app

# ── System dependencies ──────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget bash gnupg2 lsb-release software-properties-common \
    libpq-dev postgresql postgresql-server-dev-16 \
    openjdk-17-jre-headless \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

# ── Install pgvector extension ───────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-16-pgvector && \
    rm -rf /var/lib/apt/lists/*

# ── Install Neo4j Community Edition ──────────────────────────
RUN wget -qO- https://dist.neo4j.org/neo4j-community-5.26.0-unix.tar.gz | \
    tar -xz -C /opt/ && \
    ln -s /opt/neo4j-community-5.26.0 /opt/neo4j && \
    /opt/neo4j/bin/neo4j-admin dbms set-initial-password medicobuddy_dev

ENV NEO4J_HOME=/opt/neo4j
ENV PATH="${NEO4J_HOME}/bin:${PATH}"

# ── Python dependencies ─────────────────────────────────────
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Pre-download Qwen3-Embedding-0.6B ───────────────────────
RUN python -c "\
from sentence_transformers import SentenceTransformer; \
m = SentenceTransformer('Qwen/Qwen3-Embedding-0.6B', trust_remote_code=True); \
print(f'Qwen3-Embedding-0.6B cached (dim={m.get_sentence_embedding_dimension()})')"

# ── Copy application ────────────────────────────────────────
COPY . .
RUN pip install --no-cache-dir --no-deps -e .

# Make scripts executable
RUN chmod +x scripts/*.sh 2>/dev/null || true

# ── Environment ─────────────────────────────────────────────
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV POSTGRES_HOST=localhost
ENV POSTGRES_PORT=5432
ENV POSTGRES_DB=medicobuddy
ENV POSTGRES_USER=medicobuddy_internal
ENV POSTGRES_PASSWORD=medicobuddy_dev
ENV NEO4J_URI=bolt://localhost:7687
ENV NEO4J_USER=neo4j
ENV NEO4J_PASSWORD=medicobuddy_dev
ENV NEO4J_EDITION=community
ENV MCP_ENABLED=false

# HF Spaces port
EXPOSE 7860

ENTRYPOINT ["bash", "scripts/start_hf_space.sh"]
