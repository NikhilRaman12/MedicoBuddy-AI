# ──────────────────────────────────────────────────────────────
# MedicoBuddy AI — Single-Secret Open-Source Configuration
# Architecture: LangGraph + Neo4j Community + pgvector + Groq LLM + Qwen3-Embedding-0.6B (Local)
# Only GROQ_API_KEY is required. All other credentials are auto-generated.
# ──────────────────────────────────────────────────────────────

# ── REQUIRED: Your only external secret ──────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embedding Model (loaded locally via sentence-transformers) ─
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024

# ── PostgreSQL / pgvector (internal — auto-generated password) ─
POSTGRES_DB=medicobuddy
POSTGRES_USER=medicobuddy_internal
# POSTGRES_PASSWORD is auto-generated by bootstrap if absent.
# POSTGRES_PASSWORD=

# ── Neo4j Community Edition (internal — auto-generated password)
NEO4J_EDITION=community
# NEO4J_PASSWORD is auto-generated by bootstrap if absent.
# NEO4J_PASSWORD=

# ── Application ──────────────────────────────────────────────
APP_NAME=MedicoBuddy AI
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
# APP_SECRET_KEY is auto-generated by bootstrap if absent.
# APP_SECRET_KEY=

# ── FastAPI ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:8501", "http://localhost:7860"]

# ── LLM Tuning ──────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── Emergency Contacts ───────────────────────────────────────
EMERGENCY_CONTACTS={"IN": {"number": "112", "name": "Emergency Services India"}, "US": {"number": "911", "name": "Emergency Services US"}, "UK": {"number": "999", "name": "Emergency Services UK"}, "EU": {"number": "112", "name": "Emergency Services EU"}}
DEFAULT_REGION=IN

# ── Privacy & Regulatory ─────────────────────────────────────
ENABLE_CHAT_HISTORY=false
DATA_RETENTION_DAYS=30
