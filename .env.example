# ──────────────────────────────────────────────────────────────
# MedicoBuddy — Production Environment Configuration
# Architecture: LangGraph + Neo4j + Milvus/pgvector + Groq LLM + Qwen3-Embedding-8B
# ──────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=MedicoBuddy
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_MIN_32_CHARS

# ── FastAPI ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000"]

# ── LLM Provider (Groq API Primary) ───────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_CHANGE_ME_GROQ_API_KEY
GROQ_MODEL_NAME=llama-3.3-70b-versatile
# Fallbacks: mixtral-8x7b-32768, qwen-2.5-72b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── Neo4j Knowledge Graph ────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# ── Primary Vector Store: Milvus ─────────────────────────────
VECTOR_STORE_PRIMARY=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=medicobuddy_evidence_qwen3

# ── Secondary Vector Store: PostgreSQL pgvector ─────────────
ENABLE_PGVECTOR=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medicobuddy
POSTGRES_USER=medicobuddy
POSTGRES_PASSWORD=CHANGE_ME_PG_PASSWORD

# ── Embedding Model (Qwen3-Embedding-8B) ─────────────────────
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=4096
USE_LOCAL_TRANSFORMERS=false  # Set to true for local PyTorch GPU inference

# ── Redis (Rate Limiting & Caching) ─────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── MCP / NCBI Connectors ────────────────────────────────────
NCBI_API_KEY=
NCBI_EMAIL=clinician@medicobuddy.ai
NCBI_TOOL_NAME=medicobuddy_graphrag

# ── Emergency Contacts ───────────────────────────────────────
EMERGENCY_CONTACTS={"IN": {"number": "112", "name": "Emergency Services India"}, "US": {"number": "911", "name": "Emergency Services US"}, "UK": {"number": "999", "name": "Emergency Services UK"}, "EU": {"number": "112", "name": "Emergency Services EU"}}
DEFAULT_REGION=IN

# ── Privacy & Regulatory ─────────────────────────────────────
ENABLE_CHAT_HISTORY=false
DATA_RETENTION_DAYS=30
ENCRYPT_AT_REST=true
